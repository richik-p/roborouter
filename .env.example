DATABASE_URL=postgresql+asyncpg://roborouter:roborouter@localhost:5432/roborouter
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY=roborouter
S3_SECRET_KEY=roborouter-local-only
S3_BUCKET=roborouter-artifacts
S3_VERIFY_UPLOADS=true
WORKER_BOOTSTRAP_TOKEN=
WORKER_BOOTSTRAP_ID=local-worker
WORKER_TOKEN=
# Evaluation access. "key" (default) requires a launch key to queue or cancel jobs.
# The bootstrap value below is for local development only; never reuse it remotely.
EVALUATION_ACCESS=key
LAUNCH_BOOTSTRAP_TOKEN=rrl_local-dev.local-dev-only-secret
LAUNCH_BOOTSTRAP_ROLE=operator
MAX_ACTIVE_EVALUATIONS=4
MAX_SEEDS_PER_EVALUATION=10
AUTO_CREATE_SCHEMA=false
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_REPOSITORY_URL=https://github.com/richik-p/roborouter
NEXT_PUBLIC_PILOT_CONTACT_EMAIL=
