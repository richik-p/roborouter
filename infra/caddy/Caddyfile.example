{$APP_DOMAIN} {
    basic_auth {
        {$OPERATOR_USERNAME} {$OPERATOR_PASSWORD_HASH}
    }

    @api path /health /v0/*
    handle @api {
        reverse_proxy 127.0.0.1:8000
    }

    handle {
        reverse_proxy 127.0.0.1:3000
    }
}

{$WORKER_DOMAIN} {
    @worker_api path /private/workers/*
    handle @worker_api {
        reverse_proxy 127.0.0.1:8000
    }

    @job_status {
        method GET
        path /v0/evaluations/*
    }
    handle @job_status {
        reverse_proxy 127.0.0.1:8000
    }

    respond 404
}

{$ARTIFACT_DOMAIN} {
    reverse_proxy 127.0.0.1:9000
}
