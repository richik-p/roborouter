[Unit]
Description=RoboRouter web application
After=network-online.target roborouter-api.service
Wants=network-online.target

[Service]
Type=simple
User=roborouter
Group=roborouter
WorkingDirectory=/opt/roborouter
EnvironmentFile=/etc/roborouter/control-plane.env
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
