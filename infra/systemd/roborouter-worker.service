[Unit]
Description=RoboRouter outbound NVIDIA evaluation worker
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=roborouter-worker
Group=roborouter-worker
WorkingDirectory=/opt/roborouter
EnvironmentFile=/etc/roborouter/worker.env
Environment=PATH=/opt/roborouter/vendor/vla-evaluation-harness/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/opt/roborouter/.venv/bin/roborouter-worker
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/roborouter-worker

[Install]
WantedBy=multi-user.target
